# ============================================================
# Projeto Córtex IA (v2.9.0) — Configuração de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env no Git.

# --- Modo de Execução & Broker ---
# BROKER_MODE: simulator | mt5 | bridge
SIMULATION_MODE=true
BROKER_MODE=simulator

# --- MetaTrader 5 (Windows Nativo ou Container Headless Wine + REST Bridge) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=ClearInvestimentos-CLEAR
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_MAGIC=234000

# --- MT5 REST Bridge (Obrigatório em Linux/VPS p/ Produção Real na B3) ---
MT5_BRIDGE_URL=http://127.0.0.1:5000
BRIDGE_API_KEY=
# Opcional: senha para painel diagnóstico noVNC local (127.0.0.1:6080) no container mt5-bridge
VNC_PASSWORD=

# --- Gestão de Capital, Risco & Universo de Ativos B3 ---
CAPITAL_INICIAL=1000000.00
STOP_LOSS_PERCENT=0.10
TRAILING_STOP_TRIGGER_PERCENT=0.02
TRAILING_STOP_DISTANCE_PERCENT=0.015
MAX_POSITIONS=0
MAX_DAILY_LOSS_PERCENT=0.03
MAX_CONCENTRATION=0.25
# Lista opcional separada por vírgulas (ex: PETR4,VALE3,ITUB4). Vazio = universo líquido padrão B3.
WATCHLIST_PORTFOLIO=

# --- Microestrutura B3, Proteção Tributária PF & Filtros Intraday (v2.9.0) ---
MAX_SPREAD_PERCENT=0.008
MAX_SLIPPAGE_PERCENT=0.003
B3_FEE_RATE=0.0003
AVOID_DAY_TRADE_TAX=true
OPENING_COOLDOWN_MINUTES=15
MARKET_REGIME_MAX_DROP_PCT=-1.5
ENABLE_MTF_CONFIRMATION=true
DECISION_RETENTION_DAYS=14

# --- Análise de Sentimento & IA Generativa (Gemini Interactions API) ---
# SENTIMENT_MODE: lightweight | gemini | full
SENTIMENT_MODE=lightweight
SENTIMENT_CACHE_TTL=1800
GEMINI_API_KEY=

# --- Notificações via Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# --- Dashboard Web & Segurança de Sessão / CORS ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8003
ALLOWED_ORIGINS=http://localhost:8003,http://127.0.0.1:8003
COOKIE_SECURE=false
AUTH_MAX_IDLE_SECONDS=900
AUTH_MAX_SESSION_SECONDS=28800
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# --- Intervalos Operacionais & Logs ---
TRADING_CYCLE_INTERVAL=60
CLOSED_CHECK_INTERVAL=300
HEALTH_CHECK_INTERVAL=120
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Deploy Remoto via Chave SSH (Opcional) ---
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_REMOTE_DIR=/home/servico/cortex-ia

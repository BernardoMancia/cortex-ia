# ============================================
# Projeto Córtex - Configuração de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# MetaTrader 5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=ClearInvestimentos-Server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_MAGIC=234000

# Telegram Bot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Trading Config
SIMULATION_MODE=true
CAPITAL_INICIAL=200.00
STOP_LOSS_PERCENT=0.10

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8003

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Sentiment Analysis
SENTIMENT_MODE=lightweight
SENTIMENT_CACHE_TTL=1800
GEMINI_API_KEY=

# Deploy
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PASSWORD=

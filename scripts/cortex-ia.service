[Unit]
Description=Córtex IA Trading Bot & Secure Dashboard (B3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servico
Group=servico
WorkingDirectory=/home/servico/cortex-ia
Environment="PATH=/home/servico/cortex-ia/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/bin/mkdir -p /LOGS-PROJETOS/cortex-ia
ExecStart=/home/servico/cortex-ia/.venv/bin/python main.py
Restart=always
RestartSec=10
TimeoutStopSec=90
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# ============================================
# Projeto Córtex - .gitignore
# ============================================

# Ambiente e segredos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Distribuição / Build
dist/
build/
*.egg-info/
*.egg
*.whl
*.manifest
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Logs
logs/
*.log

# Banco de dados
*.db
*.sqlite
*.sqlite3

# Modelos ML
models/
*.onnx
*.pt
*.pth
*.bin
*.h5

# Sistema operacional
Thumbs.db
.DS_Store
desktop.ini
ehthumbs.db

# Jupyter
.ipynb_checkpoints/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy / type checkers
.mypy_cache/
.pytype/
.pyre/

# Dados temporários
tmp/
temp/
*.tmp
*.bak

# MetaTrader
*.ex5
*.set

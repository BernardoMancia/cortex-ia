# ============================================
# Projeto Córtex IA — .gitignore de Produção
# ============================================

# Ambiente e segredos
.env
.env.*
!.env.example

# Backups e Compactados
backups/
*.zip
*.tar.gz
*.tar
*.gz
*.rar
*.7z

# Python e Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Distribuição / Build
dist/
build/
*.egg-info/
*.egg
*.whl
*.manifest
*.spec

# Ambientes Virtuais
.venv/
venv/
env/
ENV/

# IDEs e Editores
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Logs e Saídas de Diagnóstico
logs/
*.log
*.log.*
*_log.txt
*output*.txt
*audit*.txt
*result*.txt
*test*.txt
*status*.txt

# Banco de Dados e Estado Runtime
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
data/simulator_state.json

# Modelos ML e Pesos
models/*.onnx
models/*.pt
models/*.pth
models/*.bin
models/*.h5

# Sistema Operacional
Thumbs.db
.DS_Store
desktop.ini
ehthumbs.db

# Pytest / Cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/

# Dados Temporários e Scratch
tmp/
temp/
*.tmp
*.bak
.temp_*

# Scripts temporários de VPS/Deploy local
audit_vps.py
deploy_cache.py
remote_engine.py
start_remote.py
check_*.py
force_reset.py
reset_data.py
update_env.py
allow_port.py

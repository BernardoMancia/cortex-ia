*.py[cod]
*.class
*.pyo
*.pyd
*.so

# Distribuição / Build
dist/
build/
*.egg-info/
*.egg
*.whl
*.manifest
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Logs
logs/
*.log

# Banco de dados e estado runtime
*.db
*.sqlite
*.sqlite3
data/*.db
data/simulator_state.json

# Modelos ML
models/*.onnx
models/*.pt
models/*.pth
models/*.bin
models/*.h5

# Sistema operacional
Thumbs.db
.DS_Store
desktop.ini
ehthumbs.db

# Jupyter
.ipynb_checkpoints/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

